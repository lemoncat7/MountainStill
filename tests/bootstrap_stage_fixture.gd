extends SceneTree
const Store = preload("res://scripts/update_store.gd")
func _init() -> void:
	var store = Store.new()
	DirAccess.make_dir_recursive_absolute(store.directory)
	var broken = "--broken" in OS.get_cmdline_user_args()
	if broken:
		var state = load("res://scripts/cultivation_state.gd").new()
		state.new_game(); assert(state.save_game())
		assert(DirAccess.copy_absolute(store.save_path, store.save_path + ".bak") == OK)
	var path = store.directory.path_join("fixture-source.gd")
	var f = FileAccess.open(path, FileAccess.WRITE)
	f.store_string('extends Node\nconst Nested = preload("res://scripts/fixture_nested.gd")\nvar frames = 0\nfunc _ready():\n\tprint("FIXTURE_GAME " + Nested.VERSION)\n')
	if not broken: f.store_string('\tget_tree().root.set_meta("update_gameplay_ready", true)\n')
	else: f.store_string('\tvar f = FileAccess.open("user://cultivation_save.json", FileAccess.WRITE)\n\tf.store_string("newer broken save"); f.close()\n')
	f.store_string('func _process(_delta):\n\tframes += 1\n\tif frames > 6: get_tree().quit()\n');f.close()
	var nested = store.directory.path_join("fixture-nested.gd")
	f = FileAccess.open(nested, FileAccess.WRITE); f.store_string('extends RefCounted\nconst VERSION = "nested-updated-2"\n'); f.close()
	var scene = store.directory.path_join("fixture-scene.tscn")
	f = FileAccess.open(scene, FileAccess.WRITE);f.store_string('[gd_scene load_steps=2 format=3]\n[ext_resource type="Script" path="res://scripts/fixture_game.gd" id="1"]\n[node name="FixtureGame" type="Node"]\nscript = ExtResource("1")\n');f.close()
	var payload = store.directory.path_join("fixture.pck")
	var packer = PCKPacker.new(); assert(packer.pck_start(payload) == OK)
	assert(packer.add_file("res://main.tscn", scene) == OK)
	assert(packer.add_file("res://scripts/fixture_game.gd", path) == OK)
	assert(packer.add_file("res://scripts/fixture_nested.gd", nested) == OK)
	assert(packer.flush() == OK)
	var hash = FileAccess.get_sha256(payload);var target = store.directory.path_join(hash + ".pck")
	assert(DirAccess.rename_absolute(payload, target) == OK)
	var record = {"schema":1,"version":"1.3.23-test.2","engine":"4.6.3","platform":store.platform,"kind":"pck","asset":"MountainStill-fixture.pck","size":FileAccess.get_file_as_bytes(target).size(),"sha256":hash,"restart_required":true,"save_schema":4,"bootstrap":1,"path":target}
	assert(store._write("pending.json", record))
	assert(store.activate_pending())
	print("FIXTURE STAGED " + ("broken" if broken else "healthy"));quit()
